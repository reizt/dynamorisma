{
	"name": "@reizt/dynamorisma",
	"version": "0.0.0-alpha.2",
	"repository": "git@github.com:reizt/dynamorisma.git",
	"author": "reizt <reizt.dev@gmail.com>",
	"license": "MIT",
	"main": "./lib/cjs/index.js",
	"types": "./lib/types/index.d.ts",
	"module": "./lib/esm/index.mjs",
	"exports": {
		".": {
			"import": "./lib/esm/index.js",
			"require": "./lib/cjs/index.js",
			"types": "./lib/types/index.d.ts"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"lib/cjs/**/*.js",
		"lib/esm/**/*.js",
		"lib/types/**/*.d.ts"
	],
	"scripts": {
		"build": "run-s cleanup build.all",
		"cleanup": "rm -rf lib/*",
		"build.all": "run-p build.cjs build.esm build.types",
		"build.cjs": "tsc --project tsconfig.cjs.json",
		"build.esm": "tsc --project tsconfig.esm.json",
		"build.types": "tsc --project tsconfig.types.json",
		"format": "biome check --write .",
		"check": "run-p check.*",
		"check.biome": "biome check .",
		"check.tsc": "tsc --incremental --noEmit",
		"check.test": "vitest run",
		"test": "vitest watch"
	},
	"dependencies": {
		"@aws-sdk/client-dynamodb": "^3.1152.0",
		"yargs": "^18.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/node": "^26.6.5",
		"@types/yargs": "^17.0.35",
		"lefthook": "^2.2.2",
		"npm-run-all": "^4.1.5",
		"typescript": "^7.0.2",
		"vitest": "^4.1.12"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@biomejs/biome",
			"esbuild",
			"lefthook"
		]
	}
}
